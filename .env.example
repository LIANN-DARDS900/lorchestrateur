# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/lorchestrateur.db

# AI governance: paid providers must be explicitly enabled.
ALLOW_PAID_AI=false
AI_PROVIDER_ORDER=local,gemini,openrouter

# Provider credentials are intentionally absent from the application defaults.
# Add only the credentials needed by installed provider adapters.
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

