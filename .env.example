# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/lorchestrateur.db
APP_AI_MODE=demo
WEB_SECRET_KEY=
WEB_HOST=127.0.0.1
WEB_PORT=5000

# AI governance: paid providers must be explicitly enabled.
ALLOW_PAID_AI=false
AI_PROVIDER_ORDER=local,gemini,openrouter
PLATFORM_MIN_QUALITY_SCORE=80

# Provider credentials are optional. Values below are placeholders only.
# Cost classes are configuration declarations: free, paid, or unknown.
# Unknown is governed as paid and remains blocked while ALLOW_PAID_AI=false.
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEMINI_COST_CLASS=unknown

OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2
OPENROUTER_COST_CLASS=unknown

# Publication governance: safest defaults make no external delivery.
PUBLISHING_ENABLED=false
PUBLISHING_DRY_RUN=true
PUBLISHING_ADAPTER_MODE=demo
PUBLISHING_MAX_RETRIES=2
PUBLISHING_LEASE_SECONDS=120
PUBLISHING_POLL_SECONDS=10
APP_TIMEZONE=Africa/Casablanca

# Live credentials are environment-managed placeholders. Never expose them in the UI.
X_PUBLISHING_ENABLED=false
X_ACCESS_TOKEN=
X_API_BASE_URL=https://api.x.com

FACEBOOK_PUBLISHING_ENABLED=false
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_GRAPH_BASE_URL=https://graph.facebook.com/v23.0

INSTAGRAM_PUBLISHING_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Blog V1 delivers a local Markdown package, not a live web publication.
BLOG_PUBLISHING_ENABLED=false
BLOG_EXPORT_DIRECTORY=./data/exports
