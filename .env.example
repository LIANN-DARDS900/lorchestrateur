# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/lorchestrateur.db

# AI governance: paid providers must be explicitly enabled.
ALLOW_PAID_AI=false
AI_PROVIDER_ORDER=local,gemini,openrouter
PLATFORM_MIN_QUALITY_SCORE=80

# Provider credentials are optional. Values below are placeholders only.
# Cost classes are configuration declarations: free, paid, or unknown.
# Unknown is governed as paid and remains blocked while ALLOW_PAID_AI=false.
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEMINI_COST_CLASS=unknown

OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2
OPENROUTER_COST_CLASS=unknown
